<main class="invite-shell" lang={@copy.lang}>
  <div class="invite-brand">
    <img
      src={static_url(@conn, ~p"/images/invite/logo.png")}
      width="196"
      height="121"
      alt="Pidro"
    />
  </div>

  <%= case @state do %>
    <% :form -> %>
      <h1>{@copy.heading}</h1>
      <section class="invite-panel" data-state="form">
        <form class="invite-form" method="post" action={~p"/app/reset-password"}>
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="token" value={@token} />
          <label for="password">{@copy.label}</label>
          <div class="invite-field">
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
              autofocus
              aria-describedby="password-rule"
              aria-invalid={@too_short && "true"}
            />
            <button
              type="button"
              hidden
              data-reveal-password
              data-show={@copy.show}
              data-hide={@copy.hide}
              aria-controls="password"
              aria-pressed="false"
            >
              {@copy.show}
            </button>
          </div>
          <p
            id="password-rule"
            class={["invite-hint", @too_short && "invite-hint--error"]}
            role={@too_short && "alert"}
          >
            {if @too_short, do: @copy.too_short, else: @copy.rule}
          </p>
          <button type="submit" class="invite-primary">{@copy.submit}</button>
        </form>
        <script defer src={static_url(@conn, ~p"/assets/js/invite.js")}>
        </script>
      </section>
    <% :done -> %>
      <h1>{@copy.done_heading}</h1>
      <section class="invite-panel" data-state="done">
        <p class="invite-copy">{@copy.done_body}</p>
        <a
          :if={@page.device in [:ios, :android]}
          class="invite-primary"
          href={@page.app_url}
          data-open-app
        >
          {@copy.open}
        </a>
        <p :if={@page.iphone_install_url || @page.play_store_url} class="invite-store-label">
          {@copy.store_label}
        </p>
        <.store_badges page={@page} iphone={@copy.iphone} />
      </section>
    <% :invalid -> %>
      <h1>{@copy.heading}</h1>
      <section class="invite-panel" data-state="invalid">
        <p class="invite-notice" role="alert">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" /><path d="M12 7v6M12 16.5v.5" stroke-linecap="round" />
          </svg>
          {@copy.invalid}
        </p>
        <form class="invite-form" method="post" action={~p"/app/reset-password/link"}>
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <label for="identifier">{@copy.identifier}</label>
          <div class="invite-field">
            <input
              id="identifier"
              name="identifier"
              type="text"
              autocomplete="username"
              autocapitalize="none"
              spellcheck="false"
              required
            />
          </div>
          <button type="submit" class="invite-primary">{@copy.new_link}</button>
        </form>
        <script defer src={static_url(@conn, ~p"/assets/js/invite.js")}>
        </script>
      </section>
    <% :sent -> %>
      <div class="invite-icon-tile" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="5" width="18" height="14" rx="2" /><path
            d="m3 7 9 6 9-6"
            stroke-linejoin="round"
          />
        </svg>
      </div>
      <h1>{@copy.sent_heading}</h1>
      <section class="invite-panel" data-state="sent" role="status">
        <p class="invite-copy">{@copy.sent}</p>
        <p class="invite-copy">{@copy.lifetime}</p>
      </section>
  <% end %>
</main>
