<main class="invite-shell" lang={@copy.lang}>
  <div class="invite-brand">
    <img
      src={static_url(@conn, ~p"/images/invite/logo.png")}
      width="196"
      height="121"
      alt="Pidro"
    />
  </div>

  <%= case @state do %>
    <% :form -> %>
      <h1>{@copy.heading}</h1>
      <section class="invite-panel" data-state="form">
        <form class="invite-form" method="post" action={~p"/app/reset-password"}>
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="token" value={@token} />
          <label for="password">{@copy.label}</label>
          <div class="invite-field">
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
              autofocus
              aria-describedby="password-rule"
              aria-invalid={@too_short && "true"}
            />
            <button
              type="button"
              hidden
              data-reveal-password
              data-show={@copy.show}
              data-hide={@copy.hide}
              aria-controls="password"
              aria-pressed="false"
            >
              {@copy.show}
            </button>
          </div>
          <p
            id="password-rule"
            class={["invite-hint", @too_short && "invite-hint--error"]}
            role={@too_short && "alert"}
          >
            {if @too_short, do: @copy.too_short, else: @copy.rule}
          </p>
          <button type="submit" class="invite-primary">{@copy.submit}</button>
        </form>
        <script defer src={static_url(@conn, ~p"/assets/js/invite.js")}>
        </script>
      </section>
    <% :done -> %>
      <h1>{@copy.done_heading}</h1>
      <section class="invite-panel" data-state="done">
        <p class="invite-copy">{@copy.done_body}</p>
        <p :if={@page.iphone_install_url || @page.play_store_url} class="invite-store-label">
          {@copy.store_label}
        </p>
        <.store_badges page={@page} iphone={@copy.iphone} />
      </section>
    <% :invalid -> %>
      <h1>{@copy.invalid_heading}</h1>
      <section class="invite-panel" data-state="invalid">
        <p class="invite-copy">{@copy.invalid_body}</p>
        <p :if={@page.iphone_install_url || @page.play_store_url} class="invite-store-label">
          {@copy.store_label}
        </p>
        <.store_badges page={@page} iphone={@copy.iphone} />
      </section>
  <% end %>
</main>
