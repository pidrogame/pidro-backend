<%= if @crawler? do %>
  <main class="invite-crawler" data-crawler-preview>
    <p>Pidro invitation</p>
  </main>
<% else %>
  <main class="invite-shell">
    <div class="invite-suit invite-suit--heart" aria-hidden="true">♥</div>
    <div class="invite-suit invite-suit--club" aria-hidden="true">♣</div>

    <section class="invite-panel" data-state="not-found">
      <div class="invite-brand">
        <img
          src={static_url(@conn, ~p"/images/invite/logo.png")}
          width="196"
          height="121"
          alt="Pidro"
        />
      </div>
      <p class="invite-eyebrow">{@page.eyebrow}</p>
      <h1>{@page.heading}</h1>
      <p class="invite-copy">{@page.body}</p>

      <div class="invite-actions">
        <p :if={@page.iphone_install_url || @page.play_store_url} class="invite-store-label">
          New to Pidro? Get the beta, it's free.
        </p>
        <div class="invite-store-links" aria-label="Download Pidro">
          <a
            :if={@page.iphone_install_url}
            href={@page.iphone_install_url}
            class="invite-store-text"
            data-store="apple"
          >
            Get Pidro Beta for iPhone
          </a>
          <a
            :if={@page.play_store_url}
            href={@page.play_store_url}
            data-store="google"
            aria-label="Get Pidro on Google Play"
          >
            <img
              src={static_url(@conn, ~p"/images/invite/google-play.png")}
              width="168"
              height="50"
              alt="Get it on Google Play"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
<% end %>
