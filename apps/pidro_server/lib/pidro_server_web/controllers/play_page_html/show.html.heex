<main class="invite-shell">
  <div class="invite-suit invite-suit--heart" aria-hidden="true">♥</div>
  <div class="invite-suit invite-suit--club" aria-hidden="true">♣</div>

  <section class="invite-panel" data-state={if @page.found, do: "player", else: "not-found"}>
    <div class="invite-brand">
      <img
        src={static_url(@conn, ~p"/images/invite/logo.png")}
        width="196"
        height="121"
        alt="Pidro"
      />
    </div>

    <div :if={@page.found} class="invite-avatar" data-player-avatar>
      <img :if={@page.avatar_url} src={@page.avatar_url} width="96" height="96" alt={@page.name} />
      <span :if={!@page.avatar_url} aria-hidden="true">{@page.initial}</span>
    </div>

    <h1>{@page.heading}</h1>

    <div class="invite-actions">
      <a
        :if={@page.found and @page.device == :ios}
        class="invite-primary"
        href={@page.ios_url}
        data-primary-action
      >
        Open in the app
      </a>

      <a
        :if={@page.found and @page.device == :android}
        class="invite-primary"
        href={@page.android_url}
        data-primary-action
      >
        Open in the app
      </a>

      <p class="invite-store-label">New to Pidro? Get the beta, it's free.</p>
      <p :if={@page.found and @page.device in [:ios, :android]} class="invite-privacy-note">
        To reconnect you with this friend after installing, we briefly match coarse device
        details for up to 30 minutes.
        <a href="https://www.pidro.online/privacy-policy" data-invite-privacy>Privacy policy</a>
      </p>
      <div class="invite-store-links" aria-label="Download Pidro">
        <a
          href={@page.iphone_install_url}
          class="invite-store-text"
          data-store="apple"
          data-deferred-capture={if @page.device == :ios, do: @page.deferred_capture_url}
          data-deferred-platform={if @page.device == :ios, do: "ios"}
        >
          Get Pidro Beta for iPhone
        </a>
        <a
          href={@page.play_store_url}
          data-store="google"
          data-deferred-capture={if @page.device == :android, do: @page.deferred_capture_url}
          data-deferred-platform={if @page.device == :android, do: "android"}
          aria-label="Get Pidro on Google Play"
        >
          <img
            src={static_url(@conn, ~p"/images/invite/google-play.png")}
            width="168"
            height="50"
            alt="Get it on Google Play"
          />
        </a>
      </div>
      <p :if={@page.found} class="invite-install-note" data-install-note>
        Installed it? Tap this link again.
      </p>
    </div>
  </section>
</main>
